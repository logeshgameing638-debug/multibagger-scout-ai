# Copy this file to .env and adjust. Never commit real secrets.
# All values have working free defaults; nothing here is required for core functionality.

# Database (SQLite by default; PostgreSQL-compatible URL for future deployment)
DATABASE_URL=sqlite:///./multibagger.db

# Optional local LLM via Ollama (disabled by default; core agents are deterministic)
OLLAMA_ENABLED=false
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Optional free-tier AI provider adapter (disabled by default; leave key empty)
FREE_AI_PROVIDER=none
FREE_AI_API_KEY=

# Data connectors
HTTP_TIMEOUT_SECONDS=20
PRICE_CACHE_TTL_MINUTES=15
NEWS_CACHE_TTL_MINUTES=30

# Scheduler (all jobs disabled until enabled in Settings page)
SCHEDULER_ENABLED=false

# Backend
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
